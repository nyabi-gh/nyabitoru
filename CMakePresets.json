{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (system libs)",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows",
            "displayName": "Windows (vcpkg)",
            "binaryDir": "${sourceDir}/build",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "windows",
            "configurePreset": "windows"
        }
    ]
}
